        </div>
        <h4 style="font-size: 1.1rem; color: #f8fafc; margin-bottom: 6px;" id="ai-classify-status-title">Classifying Titles with DeepSeek...</h4>
        <p style="font-size: 0.84rem; color: var(--text-secondary); max-width: 440px; margin: 0 auto 18px;" id="ai-classify-status-desc">
          Analyzing cultural themes, sacred traditions, deities, and geography.
        </p>

        <!-- Progress bar container -->
        <div style="background: rgba(255,255,255,0.08); border-radius: 999px; height: 8px; width: 100%; max-width: 440px; margin: 0 auto; overflow: hidden;">
          <div id="ai-classify-progress-bar" style="background: linear-gradient(90deg, #6366f1, #a855f7); width: 15%; height: 100%; border-radius: 999px; transition: width 0.4s ease;"></div>
        </div>
      </div>

      <!-- State 3: Completion & Results Summary (hidden by default) -->
      <div id="ai-classify-done-state" style="display: none; padding: 10px 0;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-md); padding: 14px 18px;">
          <span style="display: inline-flex; width: 36px; height: 36px; border-radius: 50%; background: rgba(16, 185, 129, 0.2); align-items: center; justify-content: center; color: var(--accent-emerald);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </span>
          <div>
            <h4 style="font-size: 1rem; color: #f8fafc; margin-bottom: 2px;" id="ai-classify-done-title">Classification Complete!</h4>
            <p style="font-size: 0.82rem; color: #a7f3d0;" id="ai-classify-done-subtitle">Titles have been organized into cultural folders.</p>
          </div>
        </div>

        <label class="form-label" style="margin-bottom: 8px;">Breakdown by Folder</label>
        <div id="ai-classify-summary-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; max-height: 220px; overflow-y: auto; padding-right: 4px;">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>

    <div class="modal-footer" id="ai-classify-footer">
      <button type="button" class="btn btn-ghost" onclick="closeModal('modal-ai-classify')">Cancel</button>
      <button type="button" id="btn-start-ai-classify" class="btn btn-primary" onclick="executeAiClassify()" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); border: none;">
        ✨ Start AI Classification
      </button>
    </div>
  </div>
</div>

<script>
  // Single Title Create
  async function handleCreateBacklog(event) {
    event.preventDefault();
    const form = event.target;
    const formData = new FormData(form);

    const payload = {
      title: formData.get('title'),
      topic: formData.get('topic') || '',
      folder_id: formData.get('folder_id') || null,
      priority: formData.get('priority') || 'normal',
      region: formData.get('region') || '',
      notes: formData.get('notes') || ''
    };

    try {
      const res = await fetch('/api/backlog', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      showToast('Title saved to backlog!', 'success');
      closeModal('modal-add-backlog');
      setTimeout(() => window.location.reload(), 300);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  // Bulk Create
  async function handleBulkCreateBacklog(event) {
    event.preventDefault();
    const form = event.target;
    const formData = new FormData(form);
    const btn = document.getElementById('btn-submit-bulk');
    const autoClassifyChecked = formData.get('auto_classify') === 'true';

    const payload = {
      titlesText: formData.get('titlesText'),
      folder_id: formData.get('folder_id') || null,
      priority: formData.get('priority') || 'normal',
      region: formData.get('region') || '',
      auto_classify: autoClassifyChecked
    };

    if (btn) {
      btn.disabled = true;
      btn.innerText = autoClassifyChecked ? '✨ Saving & Auto-Classifying...' : 'Saving Titles...';
    }

    try {
      const res = await fetch('/api/backlog/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      if (data.autoClassified && data.classifiedCount > 0) {
        showToast(`Saved & Auto-Classified ${data.classifiedCount} titles into cultural folders!`, 'success');
      } else {
        showToast(`Saved ${data.count} titles to backlog!`, 'success');
      }
      closeModal('modal-bulk-backlog');
      setTimeout(() => window.location.reload(), 400);
    } catch (err) {
      showToast(err.message, 'error');
      if (btn) {
        btn.disabled = false;
        btn.innerText = 'Save All Titles';
      }
    }
  }

  // Start Writing
  async function startWritingBacklog(id) {
    try {
      showToast('Initializing article draft...', 'info');
      const res = await fetch(`/api/backlog/${id}/start`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      window.location.href = data.redirectUrl;
    } catch (err) {
      showToast('Error starting writing: ' + err.message, 'error');
    }
  }

  // Edit Backlog
  async function promptEditBacklog(id) {
    try {
      const res = await fetch('/api/backlog');
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      const item = data.items.find(i => i.id === id);
      if (!item) throw new Error('Title item not found');

      document.getElementById('edit_backlog_id').value = item.id;
      document.getElementById('edit_backlog_title').value = item.title;
      document.getElementById('edit_backlog_topic').value = item.topic || '';
      document.getElementById('edit_backlog_folder').value = item.folder_id || '';
      document.getElementById('edit_backlog_status').value = item.status || 'planned';
      document.getElementById('edit_backlog_priority').value = item.priority || 'normal';
      document.getElementById('edit_backlog_region').value = item.region || '';
      document.getElementById('edit_backlog_notes').value = item.notes || '';

      openModal('modal-edit-backlog');
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  async function handleUpdateBacklog(event) {
    event.preventDefault();
    const id = document.getElementById('edit_backlog_id').value;

    const payload = {
      title: document.getElementById('edit_backlog_title').value.trim(),
      topic: document.getElementById('edit_backlog_topic').value.trim(),
      folder_id: document.getElementById('edit_backlog_folder').value || null,
      status: document.getElementById('edit_backlog_status').value,
      priority: document.getElementById('edit_backlog_priority').value,
      region: document.getElementById('edit_backlog_region').value.trim(),
      notes: document.getElementById('edit_backlog_notes').value.trim()
    };

    try {
      const res = await fetch(`/api/backlog/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      showToast('Title updated!', 'success');
      closeModal('modal-edit-backlog');
      setTimeout(() => window.location.reload(), 300);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  async function confirmDeleteBacklog(id, title) {
    if (!confirm(`Delete "${title}" from planned titles?`)) return;

    try {
      const res = await fetch(`/api/backlog/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      showToast('Title deleted from backlog', 'success');
      setTimeout(() => window.location.reload(), 300);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  // Quick Assign Folder
  async function quickAssignBacklogFolder(id, folderId, selectEl) {
    const originalValue = selectEl.getAttribute('data-prev-value') || '';
    selectEl.style.opacity = '0.5';
    selectEl.disabled = true;

    try {
      const res = await fetch(`/api/backlog/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ folder_id: folderId ? Number(folderId) : null })
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      selectEl.setAttribute('data-prev-value', folderId);
      const folderName = selectEl.options[selectEl.selectedIndex].text.replace(/^[📁\s]+/, '');
      showToast(folderId ? `Categorized into "${folderName}"` : 'Moved to Uncategorized', 'success');

      if (folderId) {
        selectEl.style.borderColor = 'rgba(56, 189, 248, 0.4)';
        selectEl.style.color = '#f8fafc';
      } else {
        selectEl.style.borderColor = 'var(--border-color)';
        selectEl.style.color = 'var(--text-secondary)';
      }
    } catch (err) {
      showToast('Error updating folder: ' + err.message, 'error');
      selectEl.value = originalValue;
    } finally {
      selectEl.style.opacity = '1';
      selectEl.disabled = false;
    }
  }

  // Open AI Classification Modal
  function openClassifyModal(preselectedScope) {
    document.getElementById('ai-classify-config-state').style.display = 'block';
    document.getElementById('ai-classify-running-state').style.display = 'none';
    document.getElementById('ai-classify-done-state').style.display = 'none';
    
    const footer = document.getElementById('ai-classify-footer');
    footer.style.display = 'flex';
    footer.innerHTML = `
      <button type="button" class="btn btn-ghost" onclick="closeModal('modal-ai-classify')">Cancel</button>
      <button type="button" id="btn-start-ai-classify" class="btn btn-primary" onclick="executeAiClassify()" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); border: none;">
        ✨ Start AI Classification
      </button>
    `;

    if (preselectedScope) {
      const radio = document.querySelector(`input[name="classify_scope"][value="${preselectedScope}"]`);
      if (radio) radio.checked = true;
    }

    openModal('modal-ai-classify');
  }

  // Execute AI Classification
  async function executeAiClassify() {
    const scopeRadio = document.querySelector('input[name="classify_scope"]:checked');
    const scope = scopeRadio ? scopeRadio.value : 'uncategorized';

    const configState = document.getElementById('ai-classify-config-state');
    const runningState = document.getElementById('ai-classify-running-state');
    const doneState = document.getElementById('ai-classify-done-state');
    const footer = document.getElementById('ai-classify-footer');
    const progressBar = document.getElementById('ai-classify-progress-bar');
    const statusTitle = document.getElementById('ai-classify-status-title');
    const statusDesc = document.getElementById('ai-classify-status-desc');

    configState.style.display = 'none';
    runningState.style.display = 'block';
    footer.style.display = 'none';

    let progress = 18;
    progressBar.style.width = '18%';
    statusTitle.innerText = scope === 'all' 
      ? 'Classifying all backlog titles with DeepSeek...' 
      : 'Classifying uncategorized titles with DeepSeek...';
    statusDesc.innerText = 'Analyzing Igbo cultural contexts, deities, traditions, and philosophy...';

    const progressInterval = setInterval(() => {
      if (progress < 90) {
        progress += Math.floor(Math.random() * 8) + 3;
        progressBar.style.width = `${Math.min(progress, 90)}%`;
      }
    }, 600);

    try {
      const res = await fetch('/api/backlog/ai-classify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scope })
      });
      const data = await res.json();
      clearInterval(progressInterval);
      progressBar.style.width = '100%';

      if (!data.success) throw new Error(data.error);

      if (data.count === 0) {
        runningState.style.display = 'none';
        configState.style.display = 'block';
        footer.style.display = 'flex';
        showToast(data.message || 'No titles needed classification.', 'info');
        closeModal('modal-ai-classify');
        return;
      }

      setTimeout(() => {
        runningState.style.display = 'none';
        doneState.style.display = 'block';
        footer.style.display = 'flex';

        document.getElementById('ai-classify-done-title').innerText = `Classified ${data.count} Titles Successfully!`;
        document.getElementById('ai-classify-done-subtitle').innerText = `All ${data.count} titles have been assigned to matching cultural folders.`;

        const grid = document.getElementById('ai-classify-summary-grid');
        grid.innerHTML = '';
        const summaryEntries = Object.entries(data.summary || {});
        if (summaryEntries.length > 0) {
          summaryEntries.forEach(([folderName, count]) => {
            const card = document.createElement('div');
            card.style.cssText = 'background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-sm); padding: 8px 12px; display: flex; align-items: center; justify-content: space-between;';
            card.innerHTML = `
              <span style="font-size: 0.85rem; color: #f8fafc; font-weight: 500;">${folderName}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: rgba(139, 92, 246, 0.2); color: var(--accent-purple); padding: 2px 8px; border-radius: 999px;">+${count}</span>
            `;
            grid.appendChild(card);
          });
        }

        footer.innerHTML = `
          <button type="button" class="btn btn-primary" onclick="window.location.reload()" style="background: linear-gradient(135deg, #10b981, #059669); border: none; width: 100%; justify-content: center;">
            ✓ View Updated Backlog
          </button>
        `;
        showToast(`✨ Classified ${data.count} titles into folders!`, 'success');
      }, 400);

    } catch (err) {
      clearInterval(progressInterval);
      runningState.style.display = 'none';
      configState.style.display = 'block';
      footer.style.display = 'flex';
      showToast('Classification error: ' + err.message, 'error');
    }
  }

  // Single Title 1-Click AI Classification
  async function aiClassifySingleTitle(id, btnEl) {
    const originalHtml = btnEl.innerHTML;
    btnEl.disabled = true;
    btnEl.innerHTML = `<svg class="spin-animation" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line></svg>`;

    const selectEl = document.getElementById(`folder-select-${id}`);
    if (selectEl) selectEl.disabled = true;

    try {
      const res = await fetch(`/api/backlog/${id}/ai-classify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      if (selectEl && data.folder) {
        selectEl.value = data.folder.id;
        selectEl.setAttribute('data-prev-value', data.folder.id);
        if (data.folder.color) {
          selectEl.style.borderColor = `${data.folder.color}88`;
          selectEl.style.color = '#f8fafc';
        }
      }

      showToast(`✨ Classified into "${data.folder.name}"!`, 'success');
      btnEl.innerHTML = `✓`;
      btnEl.style.borderColor = 'rgba(16, 185, 129, 0.4)';
      btnEl.style.color = 'var(--accent-emerald)';
      setTimeout(() => {
        btnEl.innerHTML = originalHtml;
        btnEl.disabled = false;
        btnEl.style.borderColor = 'rgba(139, 92, 246, 0.35)';
        btnEl.style.color = '#c4b5fd';
        if (selectEl) selectEl.disabled = false;
      }, 2000);
    } catch (err) {
      showToast('AI classification failed: ' + err.message, 'error');
      btnEl.innerHTML = originalHtml;
      btnEl.disabled = false;
      if (selectEl) selectEl.disabled = false;
    }
  }
</script>
