                <strong style="color: #f8fafc; font-size: 0.9rem; display: flex; align-items: center; gap: 8px;">
                  Uncategorized Titles Only
                  <span style="font-size: 0.75rem; background: rgba(56, 189, 248, 0.15); color: var(--accent-cyan); padding: 1px 8px; border-radius: 999px;">
                    <%= locals.uncategorizedTotal || 0 %> titles
                  </span>
                </strong>
                <p style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 3px;">
                  Only process titles that are not currently assigned to any folder.
                </p>
              </div>
            </label>

            <label style="display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-md); cursor: pointer; transition: border-color 0.15s;">
              <input type="radio" name="classify_scope" value="all" style="margin-top: 3px; accent-color: var(--accent-purple);">
              <div>
                <strong style="color: #f8fafc; font-size: 0.9rem; display: flex; align-items: center; gap: 8px;">
                  All Titles in Backlog
                  <span style="font-size: 0.75rem; background: rgba(139, 92, 246, 0.15); color: var(--accent-purple); padding: 1px 8px; border-radius: 999px;">
                    <%= (stats && stats.total) || 0 %> total titles
                  </span>
                </strong>
                <p style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 3px;">
                  Re-evaluate and organize all titles in your backlog into the optimal folders.
                </p>
              </div>
            </label>
          </div>
        </div>

        <div>
          <label class="form-label" style="margin-bottom: 8px;">Target Cultural Folders (<%= folders ? folders.length : 0 %>)</label>
          <div style="display: flex; flex-wrap: wrap; gap: 6px; max-height: 140px; overflow-y: auto; padding: 10px; background: rgba(0,0,0,0.25); border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.04);">
            <% if (folders) { %>
              <% folders.forEach(function(f) { %>
                <span style="font-size: 0.78rem; padding: 3px 8px; border-radius: 4px; background: rgba(255,255,255,0.05); color: #e2e8f0; display: inline-flex; align-items: center; gap: 5px; border-left: 3px solid <%= f.color || '#38bdf8' %>;">
