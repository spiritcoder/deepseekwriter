      <!-- State 2: Running / Progress State (hidden by default) -->
      <div id="ai-classify-running-state" style="display: none; padding: 25px 0; text-align: center;">
        <div style="display: inline-flex; width: 56px; height: 56px; border-radius: 50%; background: rgba(139, 92, 246, 0.12); align-items: center; justify-content: center; color: var(--accent-purple); margin-bottom: 14px;">
