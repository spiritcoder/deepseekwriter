<div class="dashboard-content">

  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 1.8rem; letter-spacing: -0.02em;">Folder Management</h1>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
        Organize your cultural articles into thematic collections, historical periods, or towns.
      </p>
    </div>

    <button type="button" class="btn btn-primary" onclick="openModal('modal-create-folder')">
      + New Folder
    </button>
  </div>

  <!-- Folders Grid -->
  <div class="articles-grid" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
    <% if (folders && folders.length > 0) { %>
      <% folders.forEach(function(f) { %>
        <div class="article-card" style="padding: 20px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="folder-badge-dot" style="background: <%= f.color || '#38bdf8' %>; width: 14px; height: 14px;"></span>
              <h3 style="font-size: 1.15rem;"><%= f.name %></h3>
            </div>
            <span class="nav-count" style="font-size: 0.82rem; padding: 4px 10px; display: inline-flex; align-items: center; gap: 6px;">
              <span><%= f.article_count || 0 %> written</span>
              <span style="opacity: 0.4;">•</span>
              <span style="color: var(--accent-cyan);"><%= f.backlog_count || 0 %> planned</span>
            </span>
          </div>

          <p style="color: var(--text-secondary); font-size: 0.86rem; line-height: 1.5; min-height: 40px; margin-bottom: 16px;">
            <%= f.description || 'No description added yet.' %>
          </p>

          <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
            <div style="display: flex; gap: 8px;">
              <a href="/backlog?folder=<%= f.slug %>" class="btn btn-primary btn-sm" title="View planned titles in this folder">
                Titles (<%= f.backlog_count || 0 %>)
              </a>
              <a href="/?folder=<%= f.slug %>" class="btn btn-secondary btn-sm" title="View written articles in this folder">
                Articles (<%= f.article_count || 0 %>)
              </a>
            </div>

            <div style="display: flex; gap: 6px;">
              <button type="button" class="btn btn-ghost btn-sm" onclick="promptEditFolder(<%= f.id %>, '<%= f.name.replace(/'/g, '\\\'') %>', '<%= (f.description || '').replace(/'/g, '\\\'') %>', '<%= f.color || '#0284c7' %>')" title="Edit Folder" style="padding: 6px 8px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
              </button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="confirmDeleteFolder(<%= f.id %>, '<%= f.name.replace(/'/g, '\\\'') %>')" style="color: var(--accent-rose); padding: 6px 8px;" title="Delete Folder">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

</div>

<!-- Modal: Edit Folder -->
<div id="modal-edit-folder" class="modal-overlay">
  <div class="modal-card">
    <div class="modal-header">
      <h3>Edit Folder</h3>
      <button type="button" class="btn btn-ghost btn-sm" onclick="closeModal('modal-edit-folder')">✕</button>
    </div>
    <form onsubmit="handleEditFolder(event)">
      <input type="hidden" id="edit_folder_id">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Folder Name *</label>
          <input type="text" id="edit_folder_name" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <input type="text" id="edit_folder_description" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Accent Color</label>
          <input type="color" id="edit_folder_color" style="height: 38px; width: 100%; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: transparent; cursor: pointer;">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('modal-edit-folder')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  function promptEditFolder(id, name, desc, color) {
    document.getElementById('edit_folder_id').value = id;
    document.getElementById('edit_folder_name').value = name;
    document.getElementById('edit_folder_description').value = desc || '';
    document.getElementById('edit_folder_color').value = color || '#0284c7';
    openModal('modal-edit-folder');
  }

  async function handleEditFolder(event) {
    event.preventDefault();
    const id = document.getElementById('edit_folder_id').value;
    const name = document.getElementById('edit_folder_name').value.trim();
    const description = document.getElementById('edit_folder_description').value.trim();
    const color = document.getElementById('edit_folder_color').value;

    try {
      const res = await fetch(`/api/folders/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description, color })
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      showToast('Folder updated!', 'success');
      closeModal('modal-edit-folder');
      setTimeout(() => window.location.reload(), 400);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  async function confirmDeleteFolder(id, name) {
    if (!confirm(`Delete folder "${name}"? Articles in this folder will become Uncategorized and will NOT be deleted.`)) {
      return;
    }

    try {
      const res = await fetch(`/api/folders/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      showToast('Folder deleted!', 'success');
      setTimeout(() => window.location.reload(), 400);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }
</script>
